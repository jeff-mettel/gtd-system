<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. `npm run install-launchd` fills the __PLACEHOLDERS__ and writes it to ~/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.jeffmettel.snowball</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__APP__/server/index.js</string>
  </array>
  <key>WorkingDirectory</key>   <string>__APP__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SNOW_DATA</key>         <string>__DATA__</string>
    <key>PORT</key>             <string>__PORT__</string>
    <key>PATH</key>             <string>__PATH__</string>
    <key>HOME</key>             <string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key>   <integer>10</integer>
  <key>StandardOutPath</key>    <string>__DATA__/runs/server.log</string>
  <key>StandardErrorPath</key>  <string>__DATA__/runs/server.err.log</string>
</dict>
</plist>
